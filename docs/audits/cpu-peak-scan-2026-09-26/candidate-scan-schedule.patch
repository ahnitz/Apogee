+/* Size 64 has natural-order output. On AVX2, scan one live lane directly
+   or use two independent vector accumulators to shorten the maximum dependency
+   chain. The final merge explicitly retains the earliest equal maximum. */
+static HWY_NOINLINE void small_scan64(BP*p,float thr,ap_peak*out,
+                                     int conj,size_t ws,size_t we,int nlane){
+  const float seed=thr>0.f?thr*thr:0.f;
+  if(nlane==1){
+    float mx=seed,re=0.f,im=0.f;int ix=-1;
+    for(size_t k=ws;k<we;k++){
+      const float r=hn::ExtractLane(p->bR[k],0),i=hn::ExtractLane(p->bI[k],0);
+      const float m=fmaf(r,r,i*i);
+      if(m>mx){mx=m;re=r;im=i;ix=(int)k;}
+    }
+    out->index=ix;out->re=re;out->im=ix<0?0.f:(conj?-im:im);
+    out->magnitude=ix<0?0.f:sqrtf(mx);return;
+  }
+  vf ma=V_SET1(seed),mb=ma;vi ia=VI_SET1(-1),ib=ia;
+  size_t k=ws;
+  for(;k+1<we;k+=2){
+    const vf ar=p->bR[k],ai=p->bI[k],br=p->bR[k+1],bi=p->bI[k+1];
+    const vf a=V_FMADD(ar,ar,V_MUL(ai,ai)),b=V_FMADD(br,br,V_MUL(bi,bi));
+    const vm ga=V_CMP_GT(a,ma),gb=V_CMP_GT(b,mb);
+    ma=V_SEL(ga,ma,a);ia=VI_SEL(ga,ia,VI_SET1((int)k));
+    mb=V_SEL(gb,mb,b);ib=VI_SEL(gb,ib,VI_SET1((int)k+1));
+  }
+  if(k<we){
+    const vf r=p->bR[k],i=p->bI[k],m=V_FMADD(r,r,V_MUL(i,i));
+    const vm g=V_CMP_GT(m,ma);ma=V_SEL(g,ma,m);ia=VI_SEL(g,ia,VI_SET1((int)k));
+  }
+  const vm tie=hn::And(hn::Eq(ma,mb),hn::RebindMask(AP_D,hn::Lt(ib,ia)));
+  const vm g=hn::Or(V_CMP_GT(mb,ma),tie);
+  float mv[AP_W];int xv[AP_W];V_STOREU(mv,V_SEL(g,ma,mb));VI_STOREU(xv,VI_SEL(g,ia,ib));
+  for(int l=0;l<nlane;l++){
+    ap_peak*o=out+l;o->index=xv[l];
+    if(xv[l]<0){o->re=0.f;o->im=0.f;o->magnitude=0.f;}
+    else{
+      const float r=hn::ExtractLane(p->bR[xv[l]],l),i=hn::ExtractLane(p->bI[xv[l]],l);
+      o->re=r;o->im=conj?-i:i;o->magnitude=sqrtf(mv[l]);
     }
   }
 }
