    rows, because a scattered template selection has no single stride. */
+#if HWY_TARGET == HWY_AVX2 && defined(__GNUC__) && !defined(__clang__)
+__attribute__((optimize("align-loops=32")))
+#endif
 static void small_scan(BP*p,size_t binsize,float thr,ap_peak*out,size_t ostride,
                        int conj,size_t ws,size_t we,int nlane){
   const size_t nb=(we-ws+binsize-1)/binsize;
@@ -748,6 +751,34 @@
     }
   }
 }
+
+#if HWY_TARGET == HWY_AVX3 || HWY_TARGET == HWY_SSE4
+/* Single-bin scan: keep the winning sample and index in registers.  Visit
+   natural lag order so strict comparisons retain the earliest equal maximum. */
+static HWY_NOINLINE void small_scan_one(BP*p,float thr,ap_peak*out,size_t ostride,
+                           int conj,size_t ws,size_t we,int nlane){
+  vf mx=V_SET1(thr>0.f?thr*thr:0.f), re=V_ZERO(), im=V_ZERO();
+  vi ix=VI_SET1(-1);
+  for(size_t k=ws;k<we;k++){
+    const int e=eidx(&p->ea,(int)k);
+    const vf r=p->bR[e], i=p->bI[e];
+    const vf m=V_FMADD(r,r,V_MUL(i,i));
+    const vm g=V_CMP_GT(m,mx);
+    if(__builtin_expect(V_MASK_ANY(g),0)){
+      mx=V_SEL(g,mx,m); re=V_SEL(g,re,r); im=V_SEL(g,im,i);
+      ix=VI_SEL(g,ix,VI_SET1((int)k));
+    }
+  }
+  float mv[AP_W],rv[AP_W],iv[AP_W]; int xv[AP_W];
+  V_STOREU(mv,mx); V_STOREU(rv,re); V_STOREU(iv,im); VI_STOREU(xv,ix);
+  for(int l=0;l<nlane;l++){
+    ap_peak *o=out+(size_t)l*ostride;
+    if(xv[l]<0){o->index=-1;o->re=0.f;o->im=0.f;o->magnitude=0.f;}
+    else{o->index=xv[l];o->re=rv[l];o->im=conj?-iv[l]:iv[l];o->magnitude=sqrtf(mv[l]);}
+  }
+}
+
+#endif

