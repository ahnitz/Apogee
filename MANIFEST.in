# setuptools only guesses at Python files, so every C source the build needs
# has to be named here.  Without this the sdist builds fine and then fails to
# install: the extension sources are simply absent.
include README.md LICENSE
recursive-include src *.c *.cc *.h *.py
recursive-include python *.c *.h
recursive-include tests *.c *.h *.py
recursive-include tools *.py
recursive-include docs *.md
# Highway is vendored as a submodule, and the build needs it: an sdist without
# it installs only where Highway is already present.
recursive-include third_party/highway/hwy *.h *.cc *.h.in
include third_party/highway/LICENSE
prune build
global-exclude *.pyc *.so *.o __pycache__

# The measured tuning tables, read at run time and shipped with the package.
recursive-include python/matchedfilter *.txt

# The ahead-of-time GPU kernels, and the Slang they were built from. The
# blobs are what ships and what runs; the source is included so an sdist can
# be rebuilt with tools/build_spirv.py, which needs slangc and is therefore a
# build-time tool rather than something a user ever invokes.
recursive-include python/matchedfilter/spirv *.spv manifest.json
recursive-include src/gpu *.slang
